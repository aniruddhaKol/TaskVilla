{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manage sharing",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "share",
        "revoke",
        "list"
      ]
    },
    "listId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "inviteToken": {
      "type": "string"
    },
    "memberUserId": {
      "type": "string",
      "format": "uuid"
    },
    "permission": {
      "type": "string",
      "enum": [
        "editor"
      ]
    }
  },
  "required": [
    "action"
  ]
}
