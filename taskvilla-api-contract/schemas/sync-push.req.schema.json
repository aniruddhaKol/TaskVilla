{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Push changes",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "batchId": {
      "type": "string",
      "format": "uuid"
    },
    "changes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "required": [
    "deviceId",
    "batchId",
    "changes"
  ],
  "$defs": {
    "change": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Change",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changeId": {
          "type": "string",
          "format": "uuid"
        },
        "entity": {
          "type": "string",
          "enum": [
            "list",
            "task",
            "activity"
          ]
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "operation": {
          "type": "string",
          "enum": [
            "upsert",
            "delete"
          ]
        },
        "baseRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "payload": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "clientModifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "changeId",
        "entity",
        "entityId",
        "operation",
        "baseRevision",
        "clientModifiedAt"
      ]
    }
  }
}
