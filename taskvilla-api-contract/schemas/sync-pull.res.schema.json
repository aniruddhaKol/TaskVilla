{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pull result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/serverChange"
      }
    },
    "nextCursor": {
      "type": "string"
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": [
    "changes",
    "nextCursor",
    "hasMore"
  ],
  "$defs": {
    "serverChange": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Server change",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "list",
            "task",
            "activity"
          ]
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "type": "string",
          "enum": [
            "upsert",
            "delete"
          ]
        },
        "payload": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "serverModifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "entity",
        "entityId",
        "revision",
        "operation",
        "serverModifiedAt"
      ]
    }
  }
}
