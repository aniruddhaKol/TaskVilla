{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Refreshed session",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "accessToken": {
      "type": "string"
    },
    "refreshToken": {
      "type": "string"
    },
    "expiresInSeconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "userId",
    "accessToken",
    "refreshToken",
    "expiresInSeconds"
  ]
}
