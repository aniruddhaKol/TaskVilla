{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OTP accepted",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "email"
      ]
    },
    "expiresInSeconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "requestId",
    "delivery"
  ]
}
