{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sharing result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "accepted",
        "revoked",
        "declined",
        "listed"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Member",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "permission": {
            "type": "string",
            "enum": [
              "owner",
              "viewer",
              "editor"
            ]
          }
        },
        "required": [
          "userId",
          "permission"
        ]
      }
    },
    "invitationId": {
      "type": "string",
      "format": "uuid"
    },
    "invitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "invitationId": { "type": "string", "format": "uuid" },
          "listId": { "type": "string", "format": "uuid" },
          "inviterUserId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "permission": { "type": "string", "enum": ["viewer", "editor"] },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["invitationId", "listId", "inviterUserId", "permission", "createdAt"]
      }
    }
  },
  "required": [
    "status"
  ]
}
