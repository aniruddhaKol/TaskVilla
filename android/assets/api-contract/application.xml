<?xml version='1.0' encoding='utf-8'?>
<taskvillaBackend contractVersion="1.2.1">
  <description>Provider-neutral logical contract for local-first TaskVilla. All writes are local and network failures never block core functionality. Provider wire mappings are documented separately; no deployment profiles are selected by this contract.</description>
  <server connectTimeoutMs="10000" readTimeoutMs="30000" httpsRequired="true" />
  <transport contentType="application/json" accept="application/json" charset="UTF-8" />
  <authentication mode="bearer" tokenSource="secure-session-store" refreshOperation="tokenRefresh" unauthenticatedOperations="otpRequest,otpVerify,tokenRefresh" adapter="email-otp-session" offlineSessionBehavior="local-access-allowed-sync-disabled" reauthOnReconnect="true" />
  <sync mode="manual-or-action" cursor="opaque-server-issued" conflictStrategy="reject-stale" deletions="tombstones" idempotencyKey="batchId" pageLimit="200" writeSource="sqlite" networkOptional="true" outbox="durable-sqlite" applyRemote="transactional" advanceCursorAfterCommit="true" runWhen="manual,after-action,network-restored" noBackgroundScheduler="true" />
  <offline enabled="true" startupRequiresServer="false" localWrites="always" localReads="always" queueWhenUnavailable="true" queueStore="sqlite" queuePersistAcrossRestarts="true" deduplicateBy="changeId" neverDiscardPendingChanges="true" displaySyncStatus="non-blocking" offlineAuth="use-existing-local-identity" firstOnlineLoginRequiredForCloudSync="true">
    <retry strategy="bounded-exponential-backoff" initialDelaySeconds="2" maxDelaySeconds="60" attemptsPerTrigger="3" retryOn="network-error,408,429,500,502,503,504" respectRetryAfter="true" retrySameBatchId="true" />
    <failure on="401" action="pause-sync-refresh-session" preserveLocalChanges="true" />
    <failure on="403" action="pause-affected-sharing-or-sync-operation" preserveLocalChanges="true" />
    <failure on="409" action="record-conflict-for-resolution" preserveLocalChanges="true" />
    <failure on="410" action="start-safe-full-resync-without-deleting-outbox" preserveLocalChanges="true" />
    <failure on="400,413" action="mark-operation-needs-review" preserveLocalChanges="true" />
  </offline>
  <operations>
    <operation name="otpRequest" method="POST" path="adapter://auth/otpRequest" auth="none">
      <request contentType="application/json" schema="schemas/otp-request.req.schema.json" />
      <responses>
        <response httpStatus="200" schema="schemas/otp-request.res.schema.json" description="Supabase Auth accepted the OTP request; the adapter maps its response to this contract" />
        <response httpStatus="400" schema="schemas/error.schema.json" description="Invalid request" />
        <response httpStatus="429" schema="schemas/error.schema.json" description="Rate limited" />
        <response httpStatus="422" schema="schemas/error.schema.json" description="OTP sign-up is disabled in Supabase Auth" />
        <response httpStatus="503" schema="schemas/error.schema.json" description="Email delivery unavailable" />
      </responses>
    </operation>
    <operation name="otpVerify" method="POST" path="adapter://auth/otpVerify" auth="none">
      <request contentType="application/json" schema="schemas/otp-verify.req.schema.json" />
      <responses>
        <response httpStatus="200" schema="schemas/otp-verify.res.schema.json" description="Authenticated" />
        <response httpStatus="400" schema="schemas/error.schema.json" description="Bad request" />
        <response httpStatus="403" schema="schemas/error.schema.json" description="Supabase Auth rejected an invalid or expired code" />
        <response httpStatus="429" schema="schemas/error.schema.json" description="Rate limited" />
      </responses>
    </operation>
    <operation name="tokenRefresh" method="POST" path="adapter://auth/tokenRefresh" auth="none">
      <request contentType="application/json" schema="schemas/token-refresh.req.schema.json" />
      <responses>
        <response httpStatus="200" schema="schemas/token-refresh.res.schema.json" description="Session renewed" />
        <response httpStatus="400" schema="schemas/error.schema.json" description="Bad request" />
        <response httpStatus="400" schema="schemas/error.schema.json" description="Supabase Auth rejected an invalid or revoked refresh token" />
      </responses>
    </operation>
    <operation name="syncPush" method="POST" path="/sync/push" auth="bearer">
      <request contentType="application/json" schema="schemas/sync-push.req.schema.json" />
      <responses>
        <response httpStatus="200" schema="schemas/sync-push.res.schema.json" description="Batch processed; may contain per-item conflicts" />
        <response httpStatus="400" schema="schemas/error.schema.json" description="Malformed batch" />
        <response httpStatus="401" schema="schemas/error.schema.json" description="Unauthenticated" />
        <response httpStatus="403" schema="schemas/error.schema.json" description="Forbidden" />
        <response httpStatus="409" schema="schemas/error.schema.json" description="Batch idempotency mismatch" />
        <response httpStatus="413" schema="schemas/error.schema.json" description="Batch too large" />
        <response httpStatus="429" schema="schemas/error.schema.json" description="Rate limited" />
        <response httpStatus="500" schema="schemas/error.schema.json" description="Server error" />
      </responses>
    </operation>
    <operation name="syncPull" method="POST" path="/sync/pull" auth="bearer">
      <request contentType="application/json" schema="schemas/sync-pull.req.schema.json" />
      <responses>
        <response httpStatus="200" schema="schemas/sync-pull.res.schema.json" description="Page of changes" />
        <response httpStatus="400" schema="schemas/error.schema.json" description="Invalid cursor or request" />
        <response httpStatus="401" schema="schemas/error.schema.json" description="Unauthenticated" />
        <response httpStatus="403" schema="schemas/error.schema.json" description="Forbidden" />
        <response httpStatus="410" schema="schemas/error.schema.json" description="Cursor expired; full resync required" />
        <response httpStatus="429" schema="schemas/error.schema.json" description="Rate limited" />
        <response httpStatus="500" schema="schemas/error.schema.json" description="Server error" />
      </responses>
    </operation>
    <operation name="sharing" method="POST" path="/sharing" auth="bearer">
      <request contentType="application/json" schema="schemas/sharing.req.schema.json" />
      <responses>
        <response httpStatus="200" schema="schemas/sharing.res.schema.json" description="Action completed" />
        <response httpStatus="400" schema="schemas/error.schema.json" description="Invalid action or fields" />
        <response httpStatus="401" schema="schemas/error.schema.json" description="Unauthenticated" />
        <response httpStatus="403" schema="schemas/error.schema.json" description="Insufficient permissions" />
        <response httpStatus="404" schema="schemas/error.schema.json" description="List or invitation not found" />
        <response httpStatus="409" schema="schemas/error.schema.json" description="Invite conflict" />
        <response httpStatus="429" schema="schemas/error.schema.json" description="Rate limited" />
      </responses>
    </operation>
  </operations>
</taskvillaBackend>
